{
  "bsonType": "object",
  "description": "Published gallery pattern metadata and external payload descriptor",
  "additionalProperties": false,
  "required": ["content_id", "version", "name", "description", "usage_tags", "theme_tags", "feature_tags", "difficulty", "size_class", "card_cover_ref", "detail_preview_ref", "payload_file_ref", "payload_format_version", "payload_byte_size", "payload_sha256", "grid_width", "grid_height", "physical_width_mm", "physical_height_mm", "palette_id", "palette_version", "default_direction", "color_count", "bead_count", "recommendation_weight", "published_at", "creator", "source_type", "license_status", "review_status", "acquired_at", "publish_status", "order"],
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": { "description": "Cloud-generated record ID" },
    "content_id": { "bsonType": "string" },
    "version": { "bsonType": "string" },
    "name": { "bsonType": "string" },
    "description": { "bsonType": "string" },
    "usage_tags": { "bsonType": "array", "items": { "bsonType": "string" } },
    "theme_tags": { "bsonType": "array", "items": { "bsonType": "string" } },
    "feature_tags": { "bsonType": "array", "items": { "bsonType": "string" } },
    "difficulty": { "bsonType": "string", "enum": ["beginner", "standard", "advanced"] },
    "size_class": { "bsonType": "string", "enum": ["small", "medium", "large"] },
    "card_cover_ref": { "bsonType": "string" },
    "detail_preview_ref": { "bsonType": "string" },
    "payload_file_ref": { "bsonType": "string" },
    "payload_format_version": { "bsonType": "int", "minimum": 1 },
    "payload_byte_size": { "bsonType": "int", "minimum": 0 },
    "payload_sha256": { "bsonType": "string", "pattern": "^[a-f0-9]{64}$" },
    "grid_width": { "bsonType": "int", "minimum": 1 },
    "grid_height": { "bsonType": "int", "minimum": 1 },
    "physical_width_mm": { "bsonType": "double", "minimum": 0 },
    "physical_height_mm": { "bsonType": "double", "minimum": 0 },
    "palette_id": { "bsonType": "string" },
    "palette_version": { "bsonType": "string" },
    "default_direction": { "bsonType": "string", "enum": ["normal", "reverse"] },
    "color_count": { "bsonType": "int", "minimum": 0 },
    "bead_count": { "bsonType": "int", "minimum": 0 },
    "recommendation_weight": { "bsonType": "int", "minimum": 0 },
    "published_at": { "bsonType": "timestamp" },
    "creator": { "bsonType": "string" },
    "source_type": { "bsonType": "string", "enum": ["original", "commissioned", "licensed"] },
    "source_reference": { "bsonType": "string" },
    "license_status": { "bsonType": "string", "enum": ["pending", "approved", "rejected"] },
    "review_status": { "bsonType": "string", "enum": ["pending", "approved", "rejected"] },
    "acquired_at": { "bsonType": "timestamp" },
    "publish_status": { "bsonType": "string", "enum": ["draft", "published", "archived"] },
    "order": { "bsonType": "int", "minimum": 0 }
  }
}
